/*
 * MlxPCIDriver.iig — DriverKit DEXT PCI binding layer (core entry).
 *
 * PCIDriverKit port of AppleMCX's MlxPCIDriver (kext). The kext version used
 * IOPCIDevice (kernel IOKit) + IOMemoryMap::getVirtualAddress() for MMIO.
 * The DEXT version uses PCIDriverKit.framework's IOPCIDevice with MemoryRead/
 * Write32 and _CopyDeviceMemoryWithIndex for the BAR aperture, and
 * IOBufferMemoryDescriptor + IODMACommand for DMA.
 *
 * One instance per ConnectX device. Matches 15b3:1015 (ConnectX-4 Lx) with a
 * high IOProbeScore to win against the system AppleEthernetMLX5 DEXT.
 *
 * References: notes/11 §2 (DriverKit memory API), notes/19 Phase 2,
 *             notes/21 (entitlement checklist).
 */
#ifndef MLX_PCI_DRIVER_IIG
#define MLX_PCI_DRIVER_IIG

#include <DriverKit/IOService.iig>
#include <DriverKit/IOTimerDispatchSource.iig>
#include <DriverKit/IOInterruptDispatchSource.iig>
#include <PCIDriverKit/IOPCIDevice.iig>

class MlxUserClient;
class MlxCmd;
class MlxEQ;
class MlxUAR;
class MlxHCA;
class MlxHealth;
class MlxDMA;
class MlxFwPages;
class MlxRoCE;
struct mlx_stable_init_cycle_resp;
struct mlx_runtime_resp;
struct mlx_msix_state_resp;
struct mlx_program_msix_req;
struct mlx_query_eq_req;
struct mlx_query_eq_resp;

class MlxPCIDriver : public IOService
{
public:
    virtual bool
    init() override;

    virtual void
    free() override;

    virtual kern_return_t
    Start(IOService * provider) LOCAL;

    virtual kern_return_t
    Stop(IOService * provider) LOCAL;

    virtual kern_return_t
    NewUserClient(uint32_t type, IOUserClient **userClient) override;

    /* Hardware accessors for sub-modules. */
    IOPCIDevice *   GetPCI()   LOCALONLY { return fPci; }
    MlxCmd *        GetCmd()   LOCALONLY { return fCmd; }
    MlxEQ *         GetEQ()    LOCALONLY { return fEQ; }
    MlxEQ *         GetCompletionEQ() LOCALONLY { return fCompletionEQ; }
    /* The EQ a new CQ should be bound to. Round-robin across the primary
     * completion EQ and any extra vectors, so completion interrupts spread
     * over queues instead of funnelling through one. */
    MlxEQ *         NextCompletionEQ() LOCALONLY;
    void            BringUpExtraCompletionEqs() LOCALONLY;
    void            TeardownExtraCompletionEqs(bool destroyFirmware) LOCALONLY;
    MlxUAR *        GetUAR()   LOCALONLY { return fUAR; }
    MlxHCA *        GetHCA()   LOCALONLY { return fHCA; }
    MlxHealth *     GetHealth()LOCALONLY { return fHealth; }
    MlxDMA *        GetDMA()   LOCALONLY { return fDMA; }
    MlxFwPages *    GetPages() LOCALONLY { return fFwPages; }
    MlxRoCE *       GetRoCE()  LOCALONLY { return fRoCE; }

    /* Firmware command shortcut (implemented by MlxCmd). */
    kern_return_t   Exec(uint32_t opcode, const void *in, uint32_t inSize,
                         void *out, uint32_t outSize, uint32_t timeoutMs) LOCALONLY;

    /* BAR0 access for MMIO helpers. LOCALONLY inline. */
    IOMemoryDescriptor * GetBar0Memory() LOCALONLY { return fBar0Mem; }
    uint8_t              GetBar0Index()  LOCALONLY { return fBar0Index; }

    uint32_t        GetIssi() const  LOCALONLY { return fIssi; }
    uint32_t        GetPd() const    LOCALONLY { return fPd; }
    uint32_t        GetXrcd() const  LOCALONLY { return fXrcd; }
    uint32_t        GetDevIdx() const LOCALONLY { return fDevIdx; }
    const char *    GetDevName() const LOCALONLY { return fDevName; }

    const char *    GetBoardId() const LOCALONLY;
    uint32_t        GetIeeeVendorId() const LOCALONLY;
    bool            RoCEPublicationAllowed() const LOCALONLY;
    bool            Phase2Ready() const LOCALONLY;
    bool            DmaQuarantined() const LOCALONLY;
    bool            CompletionEventReady() const LOCALONLY;
    void            GetRuntimeStatus(struct mlx_runtime_resp *status) LOCALONLY;
    void            RetainDmaUntilReset(void *mem,
                                        void *dma,
                                        uint32_t reason) LOCALONLY;
    void            EnterDmaQuarantine(uint32_t reason) LOCALONLY;
    kern_return_t   WaitCompletionEvent(uint64_t generation,
                                        uint32_t timeoutMs,
                                        uint64_t *newGeneration) LOCALONLY;
    bool            CompletionInterruptReady() const LOCALONLY;
    /* Completion events that advanced fCompletionGeneration (IRQ or timer).
     * Device-wide; surfaced through the per-client QueryPerf snapshot so a
     * client can tell a missing interrupt from a missed wakeup. */
    uint64_t        CompletionEventCount() const LOCALONLY;
    uint64_t        CompletionWakeupCount() const LOCALONLY;
    /* MSI-X bring-up result: which step failed and with what status, plus how
     * many vectors were granted. Zeroed status with stage NONE means live. */
    void            GetInterruptStatus(uint32_t *vectors, uint32_t *status,
                                       uint32_t *stage) const LOCALONLY;
    void            GetCompletionEqStatus(uint32_t *status, uint32_t *stage,
                                          uint32_t *syndrome,
                                          uint32_t *fwStatus) const LOCALONLY;
    void            GetCompletionEqVariants(uint32_t *variant, uint32_t *tried,
                                            uint32_t *syndromes) const LOCALONLY;
    void            GetEqServiceStats(uint64_t *asyncIrq, uint64_t *completionIrq,
                                      uint64_t *timerTicks,
                                      uint32_t *timerPeriodMs) const LOCALONLY;
    kern_return_t   SetEqTimerPaused(bool paused) LOCALONLY;
    /* Host interrupt index map, filled by ProbeInterruptIndices(). kindPre is
     * the same probe run before ConfigureInterrupts, so a caller can see
     * whether the messaged indices only appear once vectors are allocated. */
    void            GetInterruptIndexMap(uint32_t *count, uint32_t *countPre,
                                         uint32_t *msixBase, uint32_t *asyncIndex,
                                         uint32_t *completionIndex,
                                         uint32_t *probeStatus,
                                         uint8_t *kind, uint8_t *kindPre,
                                         uint64_t *typeRaw,
                                         uint32_t *bind,
                                         uint32_t *compEqCount,
                                         uint64_t *compIrqByEq) const LOCALONLY;
    /* Reads the device's MSI-X capability, table head and pending bits. */
    kern_return_t   ReadMsixState(struct mlx_msix_state_resp *out) LOCALONLY;
    /* Negotiated PCIe generation and lane count from the Link Status
     * register. Both zero when the capability cannot be read. */
    void            GetPcieLink(uint32_t *speed, uint32_t *width) LOCALONLY;
    /* Writes one MSI-X table entry, or flips only its mask bit. */
    kern_return_t   ProgramMsix(struct mlx_program_msix_req *req) LOCALONLY;
    /* Asks firmware for an EQ's own state; see mlx_query_eq_resp. */
    kern_return_t   QueryEqState(const struct mlx_query_eq_req *req,
                                 struct mlx_query_eq_resp *resp) LOCALONLY;
    /* Diagnostic: creates an RMP, reads it back and reports field by field
     * whether firmware stored what was written. Proves the context layout
     * before the SRQ object model is built on top of it. */
    kern_return_t   ProbeRmpLayout(struct mlx_probe_rmp_layout_resp *resp) LOCALONLY;
    uint64_t        MsixEntryOffset(uint32_t vector,
                                    uint32_t *tableSizeOut) LOCALONLY;

private:
    kern_return_t StartEqPoller() LOCALONLY;
    void StopEqPoller() LOCALONLY;
    virtual void EqTimerOccurred(OSAction *action, uint64_t time)
        TYPE(IOTimerDispatchSource::TimerOccurred) LOCAL;
    virtual void AsyncInterruptOccurred(OSAction *action, uint64_t count,
                                        uint64_t time)
        TYPE(IOInterruptDispatchSource::InterruptOccurred) LOCAL;
    virtual void CompletionInterruptOccurred(OSAction *action, uint64_t count,
                                             uint64_t time)
        TYPE(IOInterruptDispatchSource::InterruptOccurred) LOCAL;
    kern_return_t StartInterrupts() LOCALONLY;
    void StopInterrupts() LOCALONLY;
    void DestroyPhase2FirmwareResources() LOCALONLY;
    bool InitPhase2Runtime() LOCALONLY;

    bool    FwInit() LOCALONLY;
    bool    EnableHca() LOCALONLY;
    bool    SetIssi() LOCALONLY;
    bool    SetHcaCaps() LOCALONLY;
    bool    InitHca() LOCALONLY;
    bool    TeardownHca() LOCALONLY;
    bool    DisableHca() LOCALONLY;
    bool    QueryHcaCaps() LOCALONLY;
    bool    QueryAdapter() LOCALONLY;
    bool    AllocQCounter() LOCALONLY;
    uint32_t QCounterSet() const LOCALONLY;
    kern_return_t   QueryQCounters(const struct mlx_q_counters_req *req,
                                   struct mlx_q_counters_resp *out) LOCALONLY;
    kern_return_t   ReadHcaClock(struct mlx_hca_clock_resp *out) LOCALONLY;
    uint64_t        NodeGuid() const LOCALONLY;
    uint64_t        PortGuid() const LOCALONLY;
    uint64_t        SysImageGuid() const LOCALONLY;
    void            SetVportGuids(uint64_t node, uint64_t port,
                                  uint64_t sysImage) LOCALONLY;
    /* Firmware command completion delivered as an event rather than polled.
     * mask is the bitmap of completed command slots from the EQE. */
    void            CommandEventArrived(uint32_t mask) LOCALONLY;
    kern_return_t   WaitCommandEvent(uint64_t generation, uint32_t timeoutMs,
                                     uint64_t *newGeneration) LOCALONLY;
    uint64_t        CommandGeneration() const LOCALONLY;
    void    ProbeSpareInterruptSources() LOCALONLY;
    bool    QueryHcaCap(uint16_t type, uint16_t mode, uint8_t *capability) LOCALONLY;
    bool    SetAtomicReqEndianness() LOCALONLY;
    bool    AllocPd() LOCALONLY;
    bool    AllocXrcd() LOCALONLY;
    void    Cleanup() LOCALONLY;
    bool    PerformFlr() LOCALONLY;
    /* Called from MlxUserClient (kMlxUCMethodFwReinit): restart
     * firmware init without changing the card owner. */
    kern_return_t   ReinitFw() LOCALONLY;
    kern_return_t   StableInitCycle(struct mlx_stable_init_cycle_resp *report)
        LOCALONLY;

    /* Debug interface for mlx_probe (notes/35): FLR without FwInit. */
    kern_return_t   DbgPerformFlr() LOCALONLY;

    void    RecordCompletionEqResult(uint32_t stage,
                                     kern_return_t kr) LOCALONLY;
    void    SignalCompletionEvent(uint32_t completions) LOCALONLY;
    void    BringUpCompletionEq() LOCALONLY;
    void    ProbeInterruptIndices(uint8_t *kind, uint64_t *typeRaw,
                                  uint32_t *count,
                                  kern_return_t *firstFailure) LOCALONLY;
    void    SelectInterruptIndices() LOCALONLY;
    /* Claims the MSI-X vectors before firmware initialization; see the body. */
    kern_return_t EnableMsixEarly() LOCALONLY;
    void    LogMsixEnable(const char *stage) LOCALONLY;
    kern_return_t ProbeCompletionVector(uint32_t intr,
                                        uint32_t *outEqn) LOCALONLY;
    bool    DisableBusMasterAndVerify() LOCALONLY;
    bool    NegotiateRoceCap() LOCALONLY;
    bool    PublishNubs() LOCALONLY;

    IOPCIDevice     *fPci;
    IOMemoryDescriptor *fBar0Mem;   /* BAR0 aperture from _CopyDeviceMemoryWithIndex */
    uint8_t          fBar0Index;    /* BAR index (memory index for MemoryRead/Write) */
    uint16_t         fDeviceId;
    MlxCmd          *fCmd;
    MlxEQ           *fEQ;
    MlxEQ           *fCompletionEQ;
    MlxUAR          *fUAR;
    MlxHCA          *fHCA;
    MlxHealth       *fHealth;
    MlxDMA          *fDMA;
    MlxFwPages      *fFwPages;
    MlxRoCE         *fRoCE;
    IODispatchQueue *fEqQueue;
    IOTimerDispatchSource *fEqTimer;
    IODispatchQueue *fInterruptQueue;
    IODispatchQueue *fCompletionWaitQueue;
    IODispatchQueue *fCmdWaitQueue;
    IOInterruptDispatchSource *fAsyncInterrupt;
    IOInterruptDispatchSource *fCompletionInterrupt;
    uint64_t         fCompletionGeneration;
    uint32_t         fIssi;
    uint32_t         fPd;
    uint32_t         fXrcd;
    uint32_t         fDevIdx;
    char             fDevName[16];
    bool             fHcaEnabled;
    bool             fHcaInitialized;
    bool             fRuntimePagesStarted;
    bool             fStopping;
    bool             fDmaQuarantined;
};

#endif /* MLX_PCI_DRIVER_IIG */
